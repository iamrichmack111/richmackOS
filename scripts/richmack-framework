    return parser


def main():
    parser = build_parser()

    args = parser.parse_args()

    if not args.command:
        args = parser.parse_args(
            ["reference"]
        )

    try:
        result = args.func(
            args
        )

        if isinstance(
            result,
            int,
        ):
            return result

        return 0

    except ValueError as exc:
        parser.error(
            str(exc)
        )


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
