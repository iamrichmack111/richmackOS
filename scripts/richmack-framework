def cmd_knowledge_confidence(
    args,
):
    record_id = knowledge_set_confidence(
        args.topic_name,
        args.concept,
        args.score,
        source=args.source,
    )

    heading(
        "Concept Confidence Updated",
        args.topic_name,
    )

    print_success(
        f"{args.concept}: "
        f"{args.score * 100:.1f}%"
    )

    print(
        f"Confidence record ID:   "
        f"{record_id}"
    )

    print()

    return 0


def cmd_knowledge_relate(
    args,
):
    record_id = knowledge_add_relation(
        args.topic_name,
        args.concept_a,
        args.concept_b,
        relation=args.relation,
        strength=args.strength,
    )

    heading(
        "Knowledge Connection Added",
        args.topic_name,
    )

    print_success(
        f"{args.concept_a} "
        f"--{args.relation}--> "
        f"{args.concept_b}"
    )

    print(
        f"Strength:               "
        f"{args.strength:.2f}"
    )

    print(
        f"Relationship ID:        "
        f"{record_id}"
    )

    print()

    return 0


def cmd_knowledge_show(
    args,
):
    result = knowledge_summary(
        args.topic_name
    )

    heading(
        "Knowledge Map",
        args.topic_name,
    )

    print(
        color(
            "Concepts",
            CYAN,
        )
    )

    concepts = result[
        "concepts"
    ]

    if not concepts:
        print(
            "  None recorded."
        )

    for item in concepts:
        confidence = item.get(
            "confidence"
        )

        if confidence is None:
            confidence_text = "?"
        else:
            confidence_text = (
                f"{float(confidence) * 100:.0f}%"
            )

        print(
            f"  • {item['name']} "
            f"[{confidence_text}]"
        )

        description = (
            item.get(
                "description"
            )
            or ""
        ).strip()

        if description:
            print(
                f"      {description}"
            )

    groups = (
        (
            "Notes",
            "notes",
        ),
        (
            "Mistakes",
            "mistakes",
        ),
        (
            "Questions",
            "questions",
        ),
    )

    for title, key in groups:
        print()

        print(
            color(
                title,
                CYAN,
            )
        )

        rows = result[
            key
        ]

        if not rows:
            print(
                "  None recorded."
            )

        for item in rows[:25]:
            concept = (
                item.get(
                    "concept"
                )
                or ""
            ).strip()

            prefix = (
                f"[{concept}] "
                if concept
                else ""
            )

            print(
                f"  • {prefix}"
                f"{item['body']}"
            )

    print()

    print(
        color(
            "Relationships",
            CYAN,
        )
    )

    relations = result[
        "relations"
    ]

    if not relations:
        print(
            "  None recorded."
        )

    for item in relations[:25]:
        print(
            f"  • {item['concept_a']} "
            f"--{item['relation']}--> "
            f"{item['concept_b']} "
            f"[{float(item['strength']):.2f}]"
        )

    print()

    return 0


def cmd_topic_add(
    args,
):
    topic_id = db_add_topic(
        args.name,
        description=args.description,
    )

    heading(
        "Topic Created",
        args.name,
    )

    print_success(
        f"Topic created with ID {topic_id}"
    )
    print(
        f"Description:            {args.description}"
    )
    print()


def cmd_topic_list(
    args,
):
    heading(
        "Tracked Topics"
    )

    rows = list_topics()

    if not rows:
        print(
            "No tracked topics."
        )
        print()
        return

    for row in rows:
        print(
            f"{row['name']:<30} "
            f"sessions={row['session_count']}"
        )

    print()


def cmd_log(
    args,
):
    if args.stable_reps is None:
        stable = (
            args.raw_reps
            * args.retention
        )

    else:
        stable = args.stable_reps

    if args.refresh_units is None:
        refresh = (
            args.learning_units
            / 3
        )

    else:
        refresh = args.refresh_units

    session_id = add_session(
        args.topic_name,
        raw_reps=args.raw_reps,
        stable_reps=stable,
        learning_units=args.learning_units,
        refresh_units=refresh,
        connections=args.connections,
        anti_mass=args.anti_mass,
        capability=args.capability,
        assisted_capability=args.assisted,
        solo_capability=args.solo,
        notes=args.notes,
    )

    heading(
        "Learning Session Logged",
        args.topic_name,
    )

    print_success(
        f"Learning session logged: {session_id}"
    )
    print(
        f"Raw repetitions:        {args.raw_reps:.2f}"
    )
    print(
        f"Stable repetitions:     {stable:.2f}"
    )
    print(
        f"Learning Units:         {args.learning_units:.2f}"
    )
    print(
        f"Refresh Units:          {refresh:.2f}"
    )
    print(
        f"Connections:            {args.connections:.2f}"
    )
    print()


def cmd_status(
    args,
):
    result = topic_summary(
        args.topic_name
    )

    heading(
        "Topic Status",
        result["topic"],
    )

    print(
        f"Sessions:               {result['sessions']}"
    )
    print(
        f"Raw repetitions:        {result['raw_reps']:.2f}"
    )
    print(
        f"Stable repetitions:     {result['stable_reps']:.2f}"
    )

    print()
    print_metric(
        "Retention",
        result["retention"],
    )

    if result["latest_capability"] is not None:
        print_metric(
            "Capability",
            result["latest_capability"],
        )

    print()

    leakage_ratio = (
        result["leakage"]
        / result["raw_reps"]
        if result["raw_reps"]
        else 0.0
    )

    leakage_bar = metric_bar(
        leakage_ratio,
        maximum=1.0,
    )

    leakage_color = (
        GREEN
        if leakage_ratio <= 0.20
        else YELLOW
        if leakage_ratio <= 0.40
        else RED
    )

    print(
        f"{'Leakage':<24} "
        f"{color(leakage_bar, leakage_color)} "
        f"{leakage_ratio * 100:.1f}%"
    )

    print()
    print(
        f"Learning Units:         {result['learning_units']:.2f}"
    )
    print(
        f"Refresh Units:          {result['refresh_units']:.2f}"
    )
    print(
        f"Connections:            {result['connections']:.2f}"
    )
    print(
        color(
            f"Growth multiplier:      "
            f"{result['growth_multiplier']:.4f}x",
            GREEN,
        )
    )
    print(
        f"Net information mass:   {result['net_mass']:.4f}"
    )
    print(
        f"Information density:    {result['density']:.4f}"
    )

    print()


def cmd_history(
    args,
):
    rows = topic_sessions(
        args.topic_name
    )

    heading(
        "Topic History",
        args.topic_name,
    )

    if not rows:
        print(
            "No sessions recorded."
        )
        print()
        return

    for row in rows:
        print(
            f"[{row['id']}] "
            f"{row['created_at']} "
            f"raw={row['raw_reps']:.2f} "
            f"stable={row['stable_reps']:.2f} "
            f"LU={row['learning_units']:.2f} "
            f"RU={row['refresh_units']:.2f} "
            f"connections={row['connections']:.2f}"
        )

        if row["notes"]:
            print(
                f"    {row['notes']}"
            )

    print()


def add_topic(
    parser,
):
    parser.add_argument(
        "--topic",
        default=None,
        help=(
            "Optional subject label, for example "
            "'Hebrew', 'Python', or 'World War II'."
        ),
    )


def build_parser():
    parser = argparse.ArgumentParser(
        prog="richmack framework",
        description=(
            "Richmack Framework learning and capability engine."
        ),
    )

    sub = parser.add_subparsers(
        dest="command",
    )

    ask = sub.add_parser(
        "ask",
        help=(
            "Ask the personal AI tutor a question "
            "grounded in tracked learning history."
        ),
        description=(
            "Ask the Richmack personal AI tutor a question "
            "grounded in your tracked learning history."
        ),
    )

    ask.add_argument(
        "topic_name",
        help="Tracked topic name.",
    )

    ask.add_argument(
        "--question",
        "-q",
        required=True,
        help="Question for the personal tutor.",
    )

    ask.add_argument(
        "--model",
        default=DEFAULT_MODEL,
        help=(
            "Ollama model. "
            f"Default: {DEFAULT_MODEL}"
        ),
    )

    ask.add_argument(
        "--history-limit",
        type=int,
        default=12,
    )

    ask.add_argument(
        "--timeout",
        type=float,
        default=600.0,
    )

    ask.set_defaults(
        func=cmd_ask
    )

    knowledge = sub.add_parser(
        "knowledge",
        help=(
            "Manage structured personal "
            "knowledge for a topic."
        ),
        description=(
            "Store concepts, notes, mistakes, "
            "questions, confidence scores, "
            "and relationships."
        ),
    )

    knowledge_sub = knowledge.add_subparsers(
        dest="knowledge_command",
        required=True,
