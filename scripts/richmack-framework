)


from richmack_framework import (
    adjusted_wpm,
    approach_score,
    capability_gap,
    days_for_growth,
    effective_progress,
    entropy_cost,
    growth_from_raw_reps,
    growth_multiplier,
    independence,
    information_density,
    information_mass,
    learning_unit_components,
    learning_unit_strict,
    leakage_from_rate,
    net_information_mass,
    per_rep_improvement,
    readiness,
    refresh_unit,
    refresh_unit_connected,
    stable_reps,
    stable_reps_for_growth,
    target_multiplier,
    seven_rep_growth,
)


def heading(
    title,
    topic=None,
):
    print()

    subtitle = (
        f"Topic: {topic}"
        if topic
        else None
    )

    print(
        panel(
            title,
            subtitle=subtitle,
            ansi=CYAN,
        )
    )

    print()


def cmd_reference(
    args,
):
    heading(
        "Formula Reference",
        args.topic,
    )

    formulas = (
        (
            "Seven-rep growth",
            "C_N = C_0 * 2^(N/7)",
        ),
        (
            "Growth multiplier",
            "G = 2^(N/7)",
        ),
        (
            "Target repetitions",
            "N = 7 ln(G) / ln(2)",
        ),
        (
            "Days to target",
            "d = 7 ln(G) / (m ln(2))",
        ),
        (
            "Stable repetitions",
            "S = rN",
        ),
        (
            "Leakage",
            "L = N(1-r)",
        ),
        (
            "Approach score",
            "A_i = C_i * R_i * I_i * S_i",
        ),
        (
            "Learning Unit",
            "LU = H + W + K",
        ),
        (
            "Refresh Unit",
            "RU = LU / 3",
        ),
        (
            "Information Mass",
            "M = B * log(B+1) * (R+1)",
        ),
        (
            "Net Mass",
            "M_net = M - M_anti",
        ),
        (
            "Density",
            "D = M / B",
        ),
        (
            "Capability Gap",
            "Gap = C_t - C_0",
        ),
        (
            "Target Multiplier",
            "G = C_t / C_0",
        ),
        (
            "Independence",
            "I = C_solo / C_assisted",
        ),
        (
            "Readiness",
            "R = C * S * I",
        ),
        (
            "Entropy Cost",
            "max(0, Active Items - 3)",
        ),
    )

    for name, formula in formulas:
        print(
            f"{name:<22} {formula}"
        )

    print()


def cmd_growth(
    args,
):
    heading(
        "Capability Growth",
        args.topic,
    )

    multiplier = growth_multiplier(
        args.reps
    )

    capability = seven_rep_growth(
        args.baseline,
        args.reps,
    )

    print(
        f"Baseline capability:    {args.baseline:.4f}"
    )
    print(
        f"Stable repetitions:     {args.reps:.2f}"
    )
    print(
        f"Growth multiplier:      {multiplier:.4f}x"
    )
    print(
        f"Resulting capability:   {capability:.4f}"
    )
    print(
        f"Implied growth / rep:   "
        f"{per_rep_improvement() * 100:.2f}%"
    )
    print()


def cmd_target(
    args,
):
    heading(
        "Target Growth Planning",
        args.topic,
    )

    reps = stable_reps_for_growth(
        args.growth
    )

    print(
        f"Target growth:          {args.growth:.4f}x"
    )
    print(
        f"Stable reps required:   {reps:.2f}"
    )

    if args.per_day:
        days = days_for_growth(
            args.growth,
            args.per_day,
        )

        print(
            f"Approaches per day:     {args.per_day:.2f}"
        )
        print(
            f"Estimated days:         {days:.2f}"
        )

    print()


def cmd_retention(
    args,
):
    heading(
        "Retention and Leakage",
        args.topic,
    )

    stable = stable_reps(
        args.rate,
        args.reps,
    )

    leakage = leakage_from_rate(
        args.reps,
        args.rate,
    )

    growth = growth_from_raw_reps(
        args.baseline,
        args.rate,
        args.reps,
    )

    print(
        f"Raw repetitions:        {args.reps:.2f}"
    )
    print(
        f"Retention rate:         {args.rate * 100:.2f}%"
    )
    print(
        f"Stable repetitions:     {stable:.2f}"
    )
    print(
        f"Leakage:                {leakage:.2f}"
    )
    print(
        f"Resulting capability:   {growth:.4f}"
    )
    print()


def cmd_approach(
    args,
):
    heading(
        "Ieramayu Approach Score",
        args.topic,
    )

    score = approach_score(
        args.clarity,
        args.relevance,
        args.integration,
        args.stability,
    )

    print(
        f"Clarity:                {args.clarity:.4f}"
    )
    print(
        f"Relevance:              {args.relevance:.4f}"
    )
    print(
        f"Integration:            {args.integration:.4f}"
    )
    print(
        f"Stability:              {args.stability:.4f}"
    )
    print(
        f"Approach score:         {score:.4f}"
    )
    print()


def cmd_learning(
    args,
):
    heading(
        "Learning / Refresh Units",
        args.topic,
    )

    components = learning_unit_components(
        args.happened,
        args.why,
        args.connection,
    )

    strict = learning_unit_strict(
        bool(args.happened),
        bool(args.why),
        bool(args.connection),
    )

    refresh = refresh_unit(
        args.learning_units
    )

    connected = refresh_unit_connected(
        args.new,
        args.old,
        args.connections,
    )

    print(
        f"Component score:        {components:.2f}"
    )
    print(
        f"Strict LU earned:       {strict}"
    )
    print(
        f"Manual LU supplied:     {args.learning_units:.2f}"
    )
    print(
        f"Refresh Units:          {refresh:.2f}"
    )
    print(
        f"Connected RU:           {connected:.2f}"
    )
    print()


def cmd_mass(
    args,
):
    heading(
        "Information Mass",
        args.topic,
    )

    mass = information_mass(
        args.bits,
        args.relationships,
    )

    net = net_information_mass(
        mass,
        args.anti_mass,
    )

    density = (
        information_density(
            net,
            args.bits,
        )
        if args.bits > 0
        else 0.0
    )

    print(
        f"Information bits:       {args.bits:.2f}"
    )
    print(
        f"Relationships:          {args.relationships:.2f}"
    )
    print(
        f"Gross mass:             {mass:.4f}"
    )
    print(
        f"Anti-mass:              {args.anti_mass:.4f}"
    )
    print(
        f"Net mass:               {net:.4f}"
    )
    print(
        f"Density:                {density:.4f}"
    )
    print()


def cmd_capability(
    args,
):
    heading(
        "Richmack Capability Assessment",
        args.topic,
    )

    gap = capability_gap(
        args.target,
        args.baseline,
    )

    multiplier = target_multiplier(
        args.target,
        args.baseline,
    )

    independent = independence(
        args.solo,
        args.assisted,
    )

    ready = readiness(
        args.capability,
        args.stability,
        independent,
    )

    print(
        f"Baseline capability:    {args.baseline:.4f}"
    )
    print(
        f"Target capability:      {args.target:.4f}"
    )
    print(
        f"Capability gap:         {gap:.4f}"
    )
    print(
        f"Target multiplier:      {multiplier:.4f}x"
    )
    print(
        f"Solo capability:        {args.solo:.4f}"
    )
    print(
        f"Assisted capability:    {args.assisted:.4f}"
    )
    print(
        f"Independence:           {independent:.4f}"
    )
    print(
        f"Readiness:              {ready:.4f}"
    )
    print()


def cmd_focus(
    args,
):
    heading(
        "Focus / Entropy",
        args.topic,
    )

    entropy = entropy_cost(
        args.active
    )

    progress = effective_progress(
        args.progress,
        entropy,
    )

    print(
        f"Active items:           {args.active:.2f}"
    )
    print(
        f"Raw progress:           {args.progress:.2f}"
    )
    print(
        f"Entropy cost:           {entropy:.2f}"
    )
    print(
        f"Effective progress:     {progress:.2f}"
    )

    if args.wpm is not None:
        adjusted = adjusted_wpm(
            args.wpm,
            args.error_penalty,
        )

        print(
            f"Raw WPM:                {args.wpm:.2f}"
        )
        print(
            f"Error penalty:          {args.error_penalty:.2f}"
        )
        print(
            f"Adjusted WPM:           {adjusted:.2f}"
        )

    print()




def cmd_ask(
    args,
):
    heading(
        "Richmack Personal Tutor",
        args.topic_name,
    )

    print_info(f"Model: {args.model}")
    print_info(
        "Loading Richmack Framework learning profile"
    )

    try:
        answer, context = ask_framework(
            args.topic_name,
            args.question,
            model=args.model,
            history_limit=args.history_limit,
            timeout=args.timeout,
        )
    except (
        ValueError,
        RuntimeError,
    ) as exc:
        print_error(str(exc))
        return 1

    print()
    print(
        panel(
            "RICHMACK AI",
            subtitle=f"{context.topic} personal tutor",
            ansi=MAGENTA,
        )
    )
    print()
    print_ai(answer)
    print()

    summary = context.summary

    print(
        color(
            "Framework context used:",
            CYAN,
        )
    )
    print(f"  Sessions: {summary['sessions']}")
    print(f"  Stable reps: {summary['stable_reps']:.2f}")
    print(f"  Retention: {summary['retention'] * 100:.2f}%")
    print(f"  Learning Units: {summary['learning_units']:.2f}")
    print(f"  Connections: {summary['connections']:.2f}")
    print()

    return 0



def cmd_knowledge_concept_add(
    args,
):
    concept_id = knowledge_add_concept(
        args.topic_name,
        args.concept,
        description=args.description,
    )

    heading(
        "Concept Added",
        args.topic_name,
    )

    print_success(
        f"Concept #{concept_id}: "
        f"{args.concept}"
    )

    print()

    return 0


def cmd_knowledge_concept_list(
    args,
):
    rows = knowledge_list_concepts(
        args.topic_name
    )

    heading(
        "Knowledge Concepts",
        args.topic_name,
    )

    if not rows:
        print_warning(
            "No concepts recorded."
        )

        print()
        return 0

    for row in rows:
        confidence = row[
            "confidence"
        ]

        if confidence is None:
            confidence_text = (
                "not recorded"
            )
        else:
            confidence_text = (
                f"{float(confidence) * 100:.1f}%"
            )

        print(
            f"• {row['name']}"
        )

        if row["description"]:
            print(
                f"    {row['description']}"
            )

        print(
            f"    confidence: "
            f"{confidence_text}"
        )

    print()

    return 0


def _print_knowledge_record(
    title,
    topic,
    record_id,
):
    heading(
        title,
        topic,
    )

    print_success(
        f"Stored record #{record_id}"
    )

    print()


def cmd_knowledge_note(
    args,
):
    record_id = knowledge_add_note(
        args.topic_name,
        args.text,
        concept_name=args.concept,
    )

    _print_knowledge_record(
        "Knowledge Note Added",
        args.topic_name,
        record_id,
    )

    return 0


