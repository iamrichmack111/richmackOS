#!/bin/bash

while true; do
    clear

    cat /opt/richmack/assets/logo.ans
    printf '\033[0m\n'

    printf '\033[1;36m'
    figlet -f slant "RICHMACK OS"
    printf '\033[0m'

    printf '\033[1;35mTerminal-First Linux Workspace\033[0m\n'
    printf '\033[38;5;45m────────────────────────────────────────────\033[0m\n\n'

    printf '\033[1;36m  [1]\033[0m Richmack Workspace\n'
    printf '\033[1;36m  [2]\033[0m Terminal\n'
    printf '\033[1;36m  [3]\033[0m System Information\n'
    printf '\033[1;36m  [4]\033[0m Update RichmackOS\n'
    printf '\033[1;36m  [5]\033[0m Installed Applications\n'
    printf '\033[1;33m  [6]\033[0m Reboot\n'
    printf '\033[1;31m  [7]\033[0m Shutdown\n'
    printf '\033[1;35m  [Q]\033[0m Exit\n\n'

    printf '\033[38;5;45mRichmackOS ❯ \033[0m'
    read -r choice

    case "$choice" in
        1)
            "$HOME/.local/bin/richmack-workspace"
            ;;
        2)
            clear
            echo "Type 'exit' to return to RichmackOS."
            bash
            ;;
        3)
            clear
            richmack-info
            read -rp "Press Enter to continue..."
            ;;
        4)
            sudo apt update && sudo apt upgrade
            read -rp "Press Enter to continue..."
            ;;
        5)
            clear
            pipx list
            echo
            read -rp "Press Enter to continue..."
            ;;
        6)
            sudo reboot
            ;;
        7)
            sudo poweroff
            ;;
        q|Q)
            clear
            exit 0
            ;;
    esac
done
