#!/usr/bin/env bash
# RICHMACK_METRICS_COMMAND
if [ "${1:-}" = "metrics" ]; then
    shift

    ROOT="$(
        cd "$(dirname "$0")/.." &&
        pwd
    )"

    exec python3 \
        "$ROOT/scripts/richmack-metrics" \
        "$@"
fi
# RICHMACK_METRICS_COMMAND_END
set -euo pipefail

case "${1:-}" in
    organize)
        shift
        exec /usr/bin/python3 \
            "$HOME/.richmackos/organize.py" \
            "$@"
        ;;

    watch)
        shift
        exec "$HOME/.richmackos/watchctl" \
            "$@"
        ;;

    youtube)
        shift
        exec "$HOME/.richmackos/youtube_cmd" \
            "$@"
        ;;

    rag)
        shift
        exec "$HOME/.richmackos/rag_cmd" \
            "$@"
        ;;

    *)
        exec /usr/bin/python3 \
            "$HOME/.richmackos/richmackos.py" \
            "$@"
        ;;
esac
