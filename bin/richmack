#!/usr/bin/env bash

ROOT="$(
    cd "$(dirname -- "$0")/.." &&
    pwd
)"


# Global RichmackOS Ollama backend.
#
# Priority:
#   1. RICHMACK_OLLAMA_HOST
#   2. OLLAMA_HOST
#   3. RichmackOS default
if [ -n "${RICHMACK_OLLAMA_HOST:-}" ]; then
    :
elif [ -n "${OLLAMA_HOST:-}" ]; then
    RICHMACK_OLLAMA_HOST="$OLLAMA_HOST"
else
    RICHMACK_OLLAMA_HOST="http://richmack.local:11434"
fi

export RICHMACK_OLLAMA_HOST

# RICHMACK_METRICS_COMMAND
if [ "${1:-}" = "metrics" ]; then
    shift

    exec python3 \
        "$ROOT/scripts/richmack-metrics" \
        "$@"
fi
# RICHMACK_METRICS_COMMAND_END
set -euo pipefail

case "${1:-}" in
    organize)
        shift
        exec /usr/bin/python3 \
            "$HOME/.richmackos/organize.py" \
            "$@"
        ;;

    watch)
        shift
        exec "$HOME/.richmackos/watchctl" \
            "$@"
        ;;

    youtube)
        shift
        exec "$HOME/.richmackos/youtube_cmd" \
            "$@"
        ;;

    framework)
        shift
        exec /usr/bin/python3             "$ROOT/scripts/richmack-framework"             "$@"
        ;;

    rag)
        shift
        exec "$HOME/.richmackos/rag_cmd" \
            "$@"
        ;;

    *)
        exec /usr/bin/python3 \
            "$HOME/.richmackos/richmackos.py" \
            "$@"
        ;;
esac
