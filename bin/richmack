#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    organize)
        shift
        exec /usr/bin/python3 \
            "$HOME/.richmackos/organize.py" \
            "$@"
        ;;

    watch)
        shift
        exec "$HOME/.richmackos/watchctl" \
            "$@"
        ;;

    youtube)
        shift
        exec "$HOME/.richmackos/youtube_cmd" \
            "$@"
        ;;

    rag)
        shift
        exec "$HOME/.richmackos/rag_cmd" \
            "$@"
        ;;

    *)
        exec /usr/bin/python3 \
            "$HOME/.richmackos/richmackos.py" \
            "$@"
        ;;
esac
