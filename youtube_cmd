#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in

    ask)
        shift

        exec /usr/bin/python3 \
            "$HOME/.richmackos/youtube_ask.py" \
            "$@"
        ;;

    summarize)
        shift

        exec /usr/bin/python3 \
            "$HOME/.richmackos/youtube_summarize.py" \
            "$@"
        ;;

    research)
        shift

        exec /usr/bin/python3 \
            "$HOME/.richmackos/youtube_research.py" \
            "$@"
        ;;

    add-channel)
        shift

        if [ "$#" -ne 3 ]; then
            echo 'Usage: richmack youtube add-channel KEY "Display Name" URL'
            exit 1
        fi

        KEY="$1"
        NAME="$2"
        URL="$3"

        python3 - "$KEY" "$NAME" "$URL" <<'PY'
import json
import sys
from pathlib import Path

path = (
    Path.home()
    / ".richmackos"
    / "youtube-channels.json"
)

data = json.loads(
    path.read_text(
        encoding="utf-8"
    )
)

data[sys.argv[1]] = {
    "name": sys.argv[2],
    "url": sys.argv[3]
}

path.write_text(
    json.dumps(
        data,
        indent=2,
        sort_keys=True
    )
    + "\n",
    encoding="utf-8"
)

print(
    f"Added channel: "
    f"{sys.argv[1]} -> {sys.argv[2]}"
)
PY
        ;;

    remove-channel)
        shift

        if [ "$#" -ne 1 ]; then
            echo "Usage: richmack youtube remove-channel KEY"
            exit 1
        fi

        python3 - "$1" <<'PY'
import json
import sys
from pathlib import Path

path = (
    Path.home()
    / ".richmackos"
    / "youtube-channels.json"
)

data = json.loads(
    path.read_text(
        encoding="utf-8"
    )
)

key = sys.argv[1]

if key in data:
    del data[key]

path.write_text(
    json.dumps(
        data,
        indent=2,
        sort_keys=True
    )
    + "\n",
    encoding="utf-8"
)

print(
    f"Removed channel: {key}"
)
PY
        ;;

    *)
        exec /usr/bin/python3 \
            "$HOME/.richmackos/youtube.py" \
            "$@"
        ;;
esac
