case "${1:-}" in

    ""|-h|--help|help)
        show_help
        ;;

    workflow)
        show_workflow
        ;;

    examples)
        show_examples
        ;;

    chat)
        shift
        exec /usr/bin/python3 \
          "$BASE/youtube_chat_v2.py" \
          "$@"
        ;;

    knowledge)
        shift
        exec /usr/bin/python3 \
          "$BASE/youtube_knowledge.py" \
          "$@"
        ;;

    ask)
        shift
        exec /usr/bin/python3 \
          "$BASE/youtube_ask.py" \
          "$@"
        ;;

    summarize)
        shift
        exec /usr/bin/python3 \
          "$BASE/youtube_summarize.py" \
          "$@"
        ;;

    sync)
        shift

        /usr/bin/python3 \
          "$BASE/youtube.py" \
          sync \
          "$@"

        echo
        echo "Updating YouTube Knowledge Engine..."

        /usr/bin/python3 \
          "$BASE/youtube_knowledge.py" \
          build \
          --all
        ;;

    add-channel)
        shift

        if [ "$#" -ne 3 ]; then
            echo 'Usage: richmack youtube add-channel KEY "NAME" URL'
            exit 1
        fi

        python3 - "$CHANNELS" "$1" "$2" "$3" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]
name = sys.argv[3]
url = sys.argv[4]

if path.exists():
    data = json.loads(
        path.read_text(
            encoding="utf-8"
        )
    )
else:
    data = {}

data[key] = {
    "name": name,
    "url": url,
}

path.write_text(
    json.dumps(
        data,
        indent=2,
        sort_keys=True
    ) + "\n",
    encoding="utf-8"
)

print(
    f"Added channel: {key} -> {name}"
)
PY
        ;;

    remove-channel)
        shift

        if [ "$#" -ne 1 ]; then
            echo "Usage: richmack youtube remove-channel KEY"
            exit 1
        fi

        python3 - "$CHANNELS" "$1" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]

data = json.loads(
    path.read_text(
        encoding="utf-8"
    )
)

if key not in data:
    raise SystemExit(
        f"Unknown channel: {key}"
    )

name = data[key].get(
    "name",
    key
)

del data[key]

path.write_text(
    json.dumps(
        data,
        indent=2,
        sort_keys=True
    ) + "\n",
    encoding="utf-8"
)

print(
    f"Removed channel: {key} ({name})"
)
PY
        ;;

    *)
        exec /usr/bin/python3 \
          "$BASE/youtube.py" \
          "$@"
        ;;
esac
